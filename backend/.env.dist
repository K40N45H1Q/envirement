APP_NAME=CVHOLD API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite+aiosqlite:///./default.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

BETA_ACCESS_TOKEN=replace-with-your-beta-access-token
BETA_COOKIE_NAME=cvhold_beta_access
BETA_FAILED_ATTEMPT_LIMIT=3

DEFAULT_EMPLOYER_LOGIN=
DEFAULT_EMPLOYER_PASSWORD=
DEFAULT_CANDIDATE_LOGIN=
DEFAULT_CANDIDATE_PASSWORD=
